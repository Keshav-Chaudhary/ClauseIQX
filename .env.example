# ClauseIQX - Environment Configuration Template
# Copy this file to .env and configure for your local environment.
# NEVER commit .env to version control.

# Application Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Security & Session
SESSION_SECRET=change-me-to-a-secure-random-string-at-least-32-chars-long
JWT_SECRET=change-me-to-a-secure-random-jwt-secret-key-32-chars
COOKIE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL 15+ with pgvector)
DATA_STORE=postgres
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/clauseiqx_ai
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# DATA_STORE=postgres requires DATABASE_URL; DATA_STORE=memory is the safe fallback for local demo mode without PostgreSQL.

# Redis (Queues, Cache, Rate Limiting)
REDIS_URL=redis://localhost:6379

# Private Object Storage (S3-compatible, e.g., MinIO or AWS S3)
STORAGE_PROVIDER=mock # 'mock' | 's3' | 'minio'
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=clauseiqx-documents-quarantine
S3_BUCKET_PROCESSED=clauseiqx-documents-processed
S3_BUCKET_EXPORTS=clauseiqx-exports
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadminpassword
S3_FORCE_PATH_STYLE=true

# AI Provider Configuration (decided via provider abstraction)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-api-key-here
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.0

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-openai-api-key-here
EMBEDDING_DIMENSION=1536

OCR_PROVIDER=tesseract

MALWARE_SCANNER=mock # 'mock' | 'clamav'
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Rate Limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
REDACT_SENSITIVE_DATA=true
